DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,web,lms.ai1.com.mm,lms2.ai1.com.mm
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://localhost:5173,http://localhost:8080,https://lms.ai1.com.mm,https://lms2.ai1.com.mm
SITE_URL=http://localhost:8000/

# Database (choose one style; compose may map POSTGRES_* separately)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=__SET_IN_RUNTIME__
GOOGLE_CLIENT_SECRET=__SET_IN_RUNTIME__

# Agora (required for live classroom tokens)
AGORA_APP_ID=__SET_IN_RUNTIME__
AGORA_APP_CERT=__SET_IN_RUNTIME__
AGORA_TOKEN_TTL_SEC=3600
AGORA_REQUIRE_CREDENTIALS=0

# Twilio / SMS (phone OTP; backend may be DEBUG/HTTP depending on implementation)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Observability
SENTRY_DSN=

# CORS (prod)
CORS_ALLOW_ALL_ORIGINS=1
CORS_ALLOWED_ORIGINS=https://lms.ai1.com.mm,https://lms2.ai1.com.mm

# Storage
STATIC_ROOT=/data/static
MEDIA_ROOT=/data/media
